generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
  HOLIDAY
}

// Users/Employees
model User {
  id          Int            @id @default(autoincrement())
  username    String         @unique
  email       String         @unique
  password    String
  name        String
  role        UserRole       @default(USER)
  status      EmployeeStatus @default(ACTIVE)
  department  String?
  joinedAt    DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  assignedAssets Asset[]
  occupiedRooms  Room[]
  leaveRequests  LeaveRequest[]
  attendanceRecords AttendanceRecord[]

  @@map("users")
}

// Assets Management
model Asset {
  id          Int         @id @default(autoincrement())
  name        String
  category    String
  status      AssetStatus @default(AVAILABLE)
  assignedToId Int?
  assignedTo  User?       @relation(fields: [assignedToId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("assets")
}

// Room Management
model Room {
  id          Int        @id @default(autoincrement())
  name        String
  capacity    Int
  floor       String
  status      RoomStatus @default(AVAILABLE)
  occupiedById Int?
  occupiedBy  User?      @relation(fields: [occupiedById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("rooms")
}

// Leave Management
model LeaveRequest {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id])
  type        LeaveType
  fromDate    DateTime
  toDate      DateTime
  days        Int
  reason      String?
  status      LeaveStatus @default(PENDING)
  appliedAt   DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("leave_requests")
}

// Attendance Management
model AttendanceRecord {
  id          Int              @id @default(autoincrement())
  userId      Int
  user        User             @relation(fields: [userId], references: [id])
  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  status      AttendanceStatus
  hours       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, date])
  @@map("attendance_records")
}

// Notice Management
model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notices")
}